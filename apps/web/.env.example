# ---------------------------------------------------------------------------
# apps/web — copy to .env.local for local development.
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret in one.
# ---------------------------------------------------------------------------

# Origin the Next.js server proxies /api/v1/* to (server-side only).
API_ORIGIN=http://localhost:8000

# Base path the browser calls. Same-origin by default so the session cookie can
# stay SameSite=Lax; see next.config.ts.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# `local` -> email + password (+ optional TOTP). `oidc` -> single redirect button.
# Mirrors AuthProviderKind in packages/core/src/speaker_roi_core/enums.py.
NEXT_PUBLIC_AUTH_PROVIDER=local

# Human-readable IdP name shown on the OIDC button.
NEXT_PUBLIC_OIDC_DISPLAY_NAME=corporate identity

# 1 => intercept fetch with in-process fixtures so the portal runs before the
# API exists. Dev only; the interceptor is dead-code-eliminated when unset.
NEXT_PUBLIC_API_MOCK=1

# Shown in the top bar and the login panel. Useful for staging banners.
NEXT_PUBLIC_ENVIRONMENT_LABEL=
