# =============================================================================
# Speaker ROI Platform - Environment Configuration
# =============================================================================
# Copy to .env and fill in values. The application reads .env automatically.
# Secrets must NEVER be committed — .env is in .gitignore.

# --- Application -------------------------------------------------------------
APP_ENV=local                       # local | staging | production
APP_NAME=speaker-roi
DEBUG=false
CORS_ORIGINS=http://localhost:3000  # comma-separated for multiple origins

# --- Database (PostgreSQL) ----------------------------------------------------
# The app connects as app_rw (subject to row-level security).
# Migrations connect as app_migrator (owns tables, bypasses RLS).
DB_HOST=127.0.0.1
DB_PORT=54329
DB_NAME=speaker_roi
DB_USER=app_rw
DB_PASSWORD=app_rw_pw
DB_MIGRATION_USER=app_migrator
DB_MIGRATION_PASSWORD=app_migrator_pw
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# Alembic reads this directly (not via Settings).
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:app_migrator_pw@127.0.0.1:54329/speaker_roi

# --- Redis --------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=63799
REDIS_PASSWORD=
REDIS_BROKER_DB=0
REDIS_RESULT_DB=1
REDIS_CACHE_DB=2

# --- Object Storage (S3 / MinIO) ---------------------------------------------
STORAGE_ENDPOINT_URL=http://127.0.0.1:9100
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_UPLOAD_BUCKET=speaker-roi-uploads
STORAGE_EXPORT_BUCKET=speaker-roi-exports
STORAGE_ARTIFACT_BUCKET=speaker-roi-artifacts
STORAGE_USE_PATH_STYLE=true

# --- Authentication -----------------------------------------------------------
# CHANGE THIS in any non-local environment. Used for session signing and TOTP
# secret encryption. Rotating it invalidates all sessions and MFA secrets.
AUTH_SECRET_KEY=change-me-in-production-use-a-64-char-random-string
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900

# OIDC (optional — set all four or none)
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# --- AI / Governed Narration --------------------------------------------------
# Disabled by default. The platform works without it — falls back to
# deterministic templated narration from the same fact payload.
AI_ENABLED=false
AI_PROVIDER=none                    # anthropic | azure_openai | none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=claude-sonnet-4-5
AI_MAX_OUTPUT_TOKENS=1500
AI_TEMPERATURE=0.0
AI_DAILY_REQUEST_QUOTA=500

# --- Observability ------------------------------------------------------------
OBS_LOG_LEVEL=INFO
OBS_LOG_FORMAT=console              # json in production, console for local dev
OBS_METRICS_ENABLED=true
OBS_TRACING_ENABLED=false
OBS_OTLP_ENDPOINT=
OBS_SENTRY_DSN=

# --- Analytics Engine ---------------------------------------------------------
ANALYTICS_DEFAULT_PRE_WINDOW_MONTHS=12
ANALYTICS_DEFAULT_POST_WINDOW_MONTHS=3
ANALYTICS_BOOTSTRAP_ITERATIONS=500
ANALYTICS_ANALYSIS_TIMEOUT_SECONDS=3600
